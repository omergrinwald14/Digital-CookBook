{
  // Wrangler config — tells Cloudflare how to deploy the frontend.
  "name": "digital-cookbook",            // must match the project name in the wizard
  "compatibility_date": "2026-06-30",

  // The Worker script. It serves the site AND runs the keep-alive ping below.
  "main": "./frontend-worker.js",

  "assets": {
    "directory": "./frontend",           // serve our static frontend/ folder as the web root
    // Exposes the asset server to the script as env.ASSETS, so the fetch
    // handler can hand requests straight back to it — same behavior as the
    // old assets-only Worker, including the .html stripping we rely on.
    "binding": "ASSETS"
  },

  // Keep-alive: Render's free tier sleeps a service after 15 minutes idle and
  // takes ~50s to cold-start. Pinging every 14 minutes never lets it sleep.
  // 14, not 15: at exactly 15 the ping races the sleep timer and loses.
  // Hours 3-21 UTC = 06:00-00:59 Israel time (covers both IST and IDT). Nobody
  // adds recipes at 3am, and letting it sleep overnight cuts usage from ~744
  // to ~589 of Render's 750 free instance-hours per month. An off-hours share
  // still lands: the IndexedDB queue delivers it on the next app open.
  // Cron syntax: minute hour day-of-month month day-of-week (UTC).
  "triggers": {
    "crons": ["*/14 3-21 * * *"]
  }
}
